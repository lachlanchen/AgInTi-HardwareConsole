{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazying.art/schemas/hardware-console/device-profile.schema.json",
  "title": "Hardware Console Device Profile",
  "type": "object",
  "required": ["id", "name", "cpu", "memory", "pins", "tasks", "peripherals"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inventory_complete": {"type": "boolean"},
    "cpu": {
      "type": "object",
      "required": ["architecture", "cores"],
      "properties": {
        "architecture": {"type": "string"},
        "model": {"type": "string"},
        "cores": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "clock_hz": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "capacity_bytes": {"type": ["integer", "null"], "minimum": 0},
          "address": {"type": ["string", "null"]},
          "volatile": {"type": "boolean"},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {"type": "string"},
          "port": {"type": ["string", "null"]},
          "side": {"type": ["string", "null"]},
          "position": {"type": ["integer", "null"], "minimum": 1},
          "functions": {"type": "array", "items": {"type": "string"}},
          "assignment": {"type": ["string", "null"]},
          "electrical": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "tasks": {"type": "array", "items": {"type": "object"}},
    "peripherals": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
